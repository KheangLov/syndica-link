# Public origin of this app (used for og:url / og:image). Optional: defaults to the request host.
NUXT_PUBLIC_SITE_URL=https://link.example.com
# The syndica-web app (Share lab link).
NUXT_PUBLIC_WEB_URL=https://syndica-web.vercel.app/

# Content source: "github" (newest commit, fresh seconds after a push) or "pages" (deployed site).
NUXT_CONTENT_MODE=github
NUXT_CONTENT_REPO=KheangLov/syndica-web
NUXT_CONTENT_BRANCH=main
NUXT_CONTENT_REFRESH_SECONDS=60
# Optional but recommended: a fine-grained token with read-only "Contents" on syndica-web.
# Raises GitHub's API limit from 60 to 5000 requests/hour.
NUXT_GITHUB_TOKEN=
# Secret for POST /api/revalidate — use the same value as the GitHub webhook secret.
NUXT_REVALIDATE_SECRET=
